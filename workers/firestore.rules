rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ==========================================================
       HELPERS
       ========================================================== */

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role;
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    function isLead() {
      return signedIn() && role().matches('.*-lead');
    }

    function canManage(mod) {
      return role() == 'admin'
        || (
          role() == 'pastor' &&
          mod in ['sunday','nurture','prayer','other']
        )
        || (
          isLead() &&
          role() == mod + '-lead'
        );
    }

    function worship() {
      return role() in ['admin','pastor','preaching'];
    }

    function chanOk(c) {
      return role() == 'admin'
        || c == 'general'
        || (
          c == 'childrens' &&
          role() in ['childrens','childrens-lead']
        )
        || (
          c == 'ufy' &&
          role() in ['ufy','ufy-lead']
        )
        || (
          c == 'ufw' &&
          role() in ['ufw','ufw-lead']
        )
        || (
          c == 'ufm' &&
          role() in ['ufm','ufm-lead']
        )
        || (
          c == 'production' &&
          role() in ['production','production-lead']
        )
        || (
          c == 'creatives' &&
          role() in ['creatives','creatives-lead']
        )
        || (
          c == 'leads' &&
          (isLead() || role() == 'pastor')
        )
        || (
          c == 'preaching' &&
          role() in ['pastor','preaching']
        );
    }


    /* ==========================================================
       CONFIG
       ========================================================== */

    match /config/{id} {
      allow read, write: if false;
    }


    /* ==========================================================
       SIGNUPS
       ========================================================== */

    match /signups/{uid} {

      /*
         NEW ACCOUNT
      */

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'role',
          'code'
        ])
        && request.resource.data.code ==
          get(
            /databases/$(database)/documents/config/roleCodes
          ).data[request.resource.data.role];


      /*
         IMPORTANT FIX:

         EXISTING AUTH ACCOUNT WITH AN INCOMPLETE SIGNUP
         MAY UPDATE ITS OWN SIGNUP RECORD.

         The new role/code must still be validated
         against config/roleCodes.
      */

      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'role',
          'code'
        ])
        && request.resource.data.code ==
          get(
            /databases/$(database)/documents/config/roleCodes
          ).data[request.resource.data.role];


      allow read, delete: if false;
    }


    /* ==========================================================
       USERS
       ========================================================== */

    match /users/{uid} {

      allow read: if signedIn();


      /*
         NEW USER PROFILE
      */

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'role',
          'name',
          'email',
          'createdAt'
        ])
        && exists(
          /databases/$(database)/documents/signups/$(uid)
        )
        && get(
          /databases/$(database)/documents/signups/$(uid)
        ).data.role ==
          request.resource.data.role;


      /*
         ADMIN CAN EDIT OR REMOVE USERS
      */

      allow update, delete: if isAdmin();
    }


    /* ==========================================================
       EVENTS / PROJECTS / TASKS
       ========================================================== */

    match /{coll}/{id} {

      allow read: if signedIn()
        && coll in [
          'events',
          'projects',
          'tasks',
          'inventory',
          'setlists',
          'songs'
        ];

      allow create: if signedIn()
        && coll in [
          'events',
          'projects',
          'tasks'
        ]
        && canManage(
          request.resource.data.module
        );

      allow update: if signedIn()
        && coll in [
          'events',
          'projects',
          'tasks'
        ]
        && canManage(
          resource.data.module
        );

      allow delete: if signedIn()
        && coll in [
          'events',
          'projects',
          'tasks'
        ]
        && canManage(
          resource.data.module
        );
    }


    /* ==========================================================
       INVENTORY
       ========================================================== */

    match /inventory/{id} {

      allow create, update, delete: if signedIn()
        && role() in [
          'admin',
          'production',
          'production-lead'
        ];
    }


    /* ==========================================================
       SETLISTS
       ========================================================== */

    match /setlists/{id} {

      allow create, update, delete: if signedIn()
        && worship();
    }


    /* ==========================================================
       SONGS
       ========================================================== */

    match /songs/{id} {

      allow create, update, delete: if signedIn()
        && worship();
    }


    /* ==========================================================
       ANNOUNCEMENTS
       ========================================================== */

    match /announcements/{id} {

      allow read: if signedIn()
        && (
          role() in ['admin','pastor']
          || isLead()
        );

      allow create, update, delete: if signedIn()
        && role() in ['admin','pastor'];
    }


    /* ==========================================================
       CHAT
       ========================================================== */

    match /messages/{id} {

      allow read: if signedIn()
        && chanOk(
          resource.data.channel
        );


      allow create: if signedIn()
        && request.resource.data.uid ==
          request.auth.uid
        && request.resource.data.channel is string
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500
        && chanOk(
          request.resource.data.channel
        );


      allow update: if signedIn()
        && (
          resource.data.uid ==
            request.auth.uid
          || isAdmin()
        )
        && request.resource.data.uid ==
          resource.data.uid
        && request.resource.data.channel ==
          resource.data.channel
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;


      allow delete: if signedIn()
        && (
          resource.data.uid ==
            request.auth.uid
          || isAdmin()
        );
    }
  }
}