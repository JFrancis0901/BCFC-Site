rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    /* ======================================================
       HELPERS
       ====================================================== */

    function signedIn() {

      return request.auth != null;

    }


    function role() {

      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role;

    }


    function isLead() {

      return role().matches(
        '.*-lead'
      );

    }


    function canManage(mod) {

      return role() == 'admin'

        ||

        (
          role() == 'pastor'
          &&
          mod in [
            'sunday',
            'nurture',
            'prayer',
            'other'
          ]
        )

        ||

        (
          isLead()
          &&
          role() == mod + '-lead'
        );

    }


    function worship() {

      return role() in [
        'admin',
        'pastor',
        'preaching'
      ];

    }


    function chanOk(channel) {

      return role() == 'admin'

        ||

        channel == 'general'

        ||

        channel ==
          role().replace(
            '-lead',
            ''
          )

        ||

        (
          channel == 'leads'

          &&

          (
            isLead()
            ||
            role() == 'pastor'
          )
        )

        ||

        (
          channel == 'preaching'

          &&

          role() in [
            'pastor',
            'preaching'
          ]
        );

    }


    /* ======================================================
       ROLE CODE CONFIG
       ====================================================== */

    match /config/{id} {

      allow read, write:
        if false;

    }


    /* ======================================================
       SIGNUPS
       ====================================================== */

    match /signups/{uid} {

      allow create:

        if signedIn()

        && request.auth.uid == uid

        && request.resource.data
          .keys()
          .hasOnly([
            'role',
            'code'
          ])

        && request.resource.data.code ==

          get(
            /databases/$(database)/documents/config/roleCodes
          ).data[
            request.resource.data.role
          ];

    }


    /* ======================================================
       USERS
       ====================================================== */

    match /users/{uid} {

      allow read:

        if signedIn();


      /* New user */

      allow create:

        if signedIn()

        && request.auth.uid == uid

        && request.resource.data
          .keys()
          .hasOnly([
            'role',
            'name',
            'email',
            'createdAt'
          ])

        && exists(
          /databases/$(database)/documents/signups/$(uid)
        )

        && get(
          /databases/$(database)/documents/signups/$(uid)
        ).data.role ==
           request.resource.data.role;


      /*
        Admin can update anyone.

        Normal worker can only update
        their own name.
      */

      allow update:

        if signedIn()

        && (

          role() == 'admin'

          ||

          (
            request.auth.uid == uid

            &&

            request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'name'
              ])

            &&

            request.resource.data.role ==
            resource.data.role

            &&

            request.resource.data.email ==
            resource.data.email

            &&

            request.resource.data.createdAt ==
            resource.data.createdAt
          )

        );


      /*
        Only admin can delete
        worker profiles.
      */

      allow delete:

        if signedIn()
        && role() == 'admin';

    }


    /* ======================================================
       EVENTS / PROJECTS / TASKS
       ====================================================== */

    match /{coll}/{id} {

      allow read:

        if signedIn()
        && coll in [
          'events',
          'projects',
          'tasks',
          'inventory',
          'setlists',
          'songs'
        ];


      allow create:

        if signedIn()

        && coll in [
          'events',
          'projects',
          'tasks'
        ]

        && canManage(
          request.resource.data.module
        );


      allow delete:

        if signedIn()

        && coll in [
          'events',
          'projects',
          'tasks'
        ]

        && canManage(
          resource.data.module
        );


      allow update:

        if signedIn()

        && coll in [
          'events',
          'projects',
          'tasks'
        ]

        && canManage(
          resource.data.module
        );

    }


    /* ======================================================
       INVENTORY
       ====================================================== */

    match /inventory/{id} {

      allow create:

        if signedIn()
        && role() in [
          'admin',
          'production',
          'production-lead'
        ];


      allow update, delete:

        if signedIn()
        && role() in [
          'admin',
          'production',
          'production-lead'
        ];

    }


    /* ======================================================
       SETLISTS
       ====================================================== */

    match /setlists/{id} {

      allow create, update, delete:

        if signedIn()
        && worship();

    }


    /* ======================================================
       SONGS
       ====================================================== */

    match /songs/{id} {

      allow create, update, delete:

        if signedIn()
        && worship();

    }


    /* ======================================================
       ANNOUNCEMENTS
       ====================================================== */

    match /announcements/{id} {

      allow read:

        if signedIn()

        && (
          role() in [
            'admin',
            'pastor'
          ]

          ||

          isLead()
        );


      allow create, update, delete:

        if signedIn()

        && role() in [
          'admin',
          'pastor'
        ];

    }


    /* ======================================================
       CHAT MESSAGES
       ====================================================== */

    match /messages/{id} {


      /*
        READ

        Users can only see channels they are
        allowed to access.
      */

      allow read:

        if signedIn()

        && chanOk(
          resource.data.channel
        );


      /*
        CREATE

        Users can create their own messages.
      */

      allow create:

        if signedIn()

        && request.resource.data.uid ==
           request.auth.uid

        && chanOk(
          request.resource.data.channel
        );


      /*
        UPDATE

        Admin can edit any message.

        Regular users can edit only
        their own message.
      */

      allow update:

        if signedIn()

        && (

          role() == 'admin'

          ||

          (
            resource.data.uid ==
            request.auth.uid

            &&

            request.resource.data.uid ==
            resource.data.uid

            &&

            request.resource.data.channel ==
            resource.data.channel

            &&

            request.resource.data.name ==
            resource.data.name

            &&

            request.resource.data.createdAt ==
            resource.data.createdAt
          )

        );


      /*
        DELETE

        ADMIN:
        can delete ANY message.

        NORMAL USER:
        can delete only their own message.
      */

      allow delete:

        if signedIn()

        && (

          role() == 'admin'

          ||

          resource.data.uid ==
          request.auth.uid

        );

    }

  }

}