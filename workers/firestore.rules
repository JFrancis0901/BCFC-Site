rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {


    /* ======================================================
       HELPER FUNCTIONS
       ====================================================== */

    function signedIn() {
      return request.auth != null;
    }


    function role() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role;
    }


    function isAdmin() {
      return signedIn()
        && role() == 'admin';
    }


    function isLead() {
      return signedIn()
        && role().matches('.*-lead');
    }


    /*
       Admin
       Pastor for specific modules
       Department lead for their own department
    */

    function canManage(mod) {

      return role() == 'admin'

        || (
          role() == 'pastor'
          && mod in [
            'sunday',
            'nurture',
            'prayer',
            'other'
          ]
        )

        || (
          isLead()
          && role() == mod + '-lead'
        );
    }


    function worship() {

      return role() in [
        'admin',
        'pastor',
        'preaching'
      ];
    }


    /* ======================================================
       CHAT CHANNEL PERMISSIONS
       ====================================================== */

    function chanOk(channel) {

      return role() == 'admin'

        || channel == 'general'

        || channel == role().replace('-lead', '')

        || (
          channel == 'leads'
          && (
            isLead()
            || role() == 'pastor'
          )
        )

        || (
          channel == 'preaching'
          && role() in [
            'pastor',
            'preaching'
          ]
        );
    }


    /* ======================================================
       ROLE CODE CONFIG
       ====================================================== */

    match /config/{id} {

      allow read, write: if false;
    }


    /* ======================================================
       SIGNUPS
       ====================================================== */

    match /signups/{uid} {

      allow create:

        if signedIn()
        && request.auth.uid == uid

        && request.resource.data.keys().hasOnly([
          'role',
          'code'
        ])

        && request.resource.data.code
          ==
          get(
            /databases/$(database)
            /documents/config/roleCodes
          ).data[
            request.resource.data.role
          ];
    }


    /* ======================================================
       USERS
       ====================================================== */

    match /users/{uid} {

      /*
         Signed-in users can read member names.
         This is required for @mentions.
      */

      allow read:
        if signedIn();


      /*
         New user can only create their own account
         using the role whose access code they proved.
      */

      allow create:

        if signedIn()
        && request.auth.uid == uid

        && request.resource.data.keys().hasOnly([
          'role',
          'name',
          'email',
          'createdAt'
        ])

        && exists(
          /databases/$(database)
          /documents/signups/$(uid)
        )

        && get(
          /databases/$(database)
          /documents/signups/$(uid)
        ).data.role
          ==
          request.resource.data.role;


      /*
         Only admin can change or remove members.
      */

      allow update, delete:
        if isAdmin();
    }


    /* ======================================================
       EVENTS / PROJECTS / TASKS
       ====================================================== */

    match /{coll}/{id} {

      allow read:

        if signedIn()
        && coll in [
          'events',
          'projects',
          'tasks',
          'inventory',
          'setlists',
          'songs'
        ];


      allow create:

        if signedIn()
        && coll in [
          'events',
          'projects',
          'tasks'
        ]

        && canManage(
          request.resource.data.module
        );


      allow update:

        if signedIn()
        && coll in [
          'events',
          'projects',
          'tasks'
        ]

        && canManage(
          resource.data.module
        );


      allow delete:

        if signedIn()
        && coll in [
          'events',
          'projects',
          'tasks'
        ]

        && canManage(
          resource.data.module
        );
    }


    /* ======================================================
       INVENTORY
       ====================================================== */

    match /inventory/{id} {

      allow create, update, delete:

        if signedIn()
        && role() in [
          'admin',
          'production',
          'production-lead'
        ];
    }


    /* ======================================================
       SETLISTS
       ====================================================== */

    match /setlists/{id} {

      allow create, update, delete:

        if signedIn()
        && worship();
    }


    /* ======================================================
       SONGS
       ====================================================== */

    match /songs/{id} {

      allow create, update, delete:

        if signedIn()
        && worship();
    }


    /* ======================================================
       ANNOUNCEMENTS
       ====================================================== */

    match /announcements/{id} {

      allow read:

        if signedIn()
        && (
          role() in [
            'admin',
            'pastor'
          ]
          || isLead()
        );


      allow create, update, delete:

        if signedIn()
        && role() in [
          'admin',
          'pastor'
        ];
    }


    /* ======================================================
       CHAT MESSAGES
       ====================================================== */

    match /messages/{id} {


      /*
         READ
      */

      allow read:

        if signedIn()
        && chanOk(
          resource.data.channel
        );


      /*
         SEND
      */

      allow create:

        if signedIn()

        && request.resource.data.uid
          == request.auth.uid

        && request.resource.data.channel
          is string

        && request.resource.data.text
          is string

        && request.resource.data.text.size() > 0

        && request.resource.data.text.size() <= 500

        && chanOk(
          request.resource.data.channel
        );


      /*
         EDIT
         
         Users can edit their own messages.
         Admin can edit any message.

         The UID and channel cannot be changed.
      */

      allow update:

        if signedIn()

        && (
          resource.data.uid
            == request.auth.uid

          || isAdmin()
        )

        && request.resource.data.uid
          == resource.data.uid

        && request.resource.data.channel
          == resource.data.channel

        && request.resource.data.text
          is string

        && request.resource.data.text.size() > 0

        && request.resource.data.text.size() <= 500;


      /*
         DELETE
         
         Users can delete their own messages.
         ADMIN CAN DELETE ANY MESSAGE.

         This is what fixes the
         "permission-denied" error when
         Admin clears a chat.
      */

      allow delete:

        if signedIn()

        && (
          resource.data.uid
            == request.auth.uid

          || isAdmin()
        );
    }

  }
}