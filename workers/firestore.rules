rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function userDoc(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function role(){ return userDoc().role; }
    function approved(){ return signedIn() && userDoc().role != '' && (userDoc().roleStatus == 'approved' || !('roleStatus' in userDoc())); }
    function isAdmin(){ return approved() && role() == 'admin'; }
    function isLead(){ return approved() && role().matches('.*-lead'); }
    function canManage(mod){
      return isAdmin()
        || (approved() && role() == 'pastor' && mod in ['sunday','nurture','prayer','other'])
        || (approved() && isLead() && role() == mod + '-lead');
    }
    function worship(){ return approved() && role() in ['admin','pastor','preaching']; }
    function chanOk(channel){
      return isAdmin()
        || (approved() && channel == 'general')
        || (approved() && channel == role().replace('-lead',''))
        || (approved() && channel == 'leads' && (isLead() || role() == 'pastor'))
        || (approved() && channel == 'preaching' && role() in ['pastor','preaching']);
    }

    match /config/{id} { allow read, write: if false; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['firstName','lastName','middleInitial','name','email','requestedRole','role','roleStatus','createdAt'])
        && request.resource.data.role == ''
        && request.resource.data.roleStatus == 'pending';
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','firstName','lastName','middleInitial'])
          && request.resource.data.role == resource.data.role
          && request.resource.data.roleStatus == resource.data.roleStatus
          && request.resource.data.requestedRole == resource.data.requestedRole
          && request.resource.data.email == resource.data.email
          && request.resource.data.createdAt == resource.data.createdAt);
      allow delete: if isAdmin();
    }

    match /{coll}/{id} {
      allow read: if signedIn() && coll in ['events','projects','tasks','inventory','setlists','songs'];
      allow create: if signedIn() && coll in ['events','projects','tasks'] && canManage(request.resource.data.module);
      allow delete: if signedIn() && coll in ['events','projects','tasks'] && canManage(resource.data.module);
      allow update: if signedIn() && coll in ['events','projects','tasks'] && canManage(resource.data.module);
    }
    match /inventory/{id} { allow read: if signedIn(); allow create,update,delete: if approved() && role() in ['admin','production','production-lead']; }
    match /setlists/{id} { allow read: if signedIn(); allow create,update,delete: if worship(); }
    match /songs/{id} { allow read: if signedIn(); allow create,update,delete: if worship(); }
    match /announcements/{id} { allow read: if approved() && (role() in ['admin','pastor'] || isLead()); allow create,update,delete: if approved() && role() in ['admin','pastor']; }
    match /messages/{id} {
      allow read: if approved() && chanOk(resource.data.channel);
      allow create: if approved() && request.resource.data.uid == request.auth.uid && chanOk(request.resource.data.channel);
      allow update: if approved() && (isAdmin() || (resource.data.uid == request.auth.uid && request.resource.data.uid == resource.data.uid && request.resource.data.channel == resource.data.channel && request.resource.data.name == resource.data.name && request.resource.data.createdAt == resource.data.createdAt));
      allow delete: if approved() && (isAdmin() || resource.data.uid == request.auth.uid);
    }
  }
}
