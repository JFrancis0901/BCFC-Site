// Paste into Firebase Console > Firestore > Rules

rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }


    function role() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.role;
    }


    function isLead() {
      return role().matches('.*-lead');
    }


    function canManage(mod) {

      return role() == 'admin'

        || (
          role() == 'pastor' &&
          mod in [
            'sunday',
            'nurture',
            'prayer',
            'other'
          ]
        )

        || (
          isLead() &&
          role() == mod + '-lead'
        );

    }


    function worship() {

      return role() in [
        'admin',
        'pastor',
        'preaching'
      ];

    }


    function chanOk(c) {

      return role() == 'admin'

        || c == 'general'

        || c == role().replace(
          '-lead',
          ''
        )

        || (
          c == 'leads' &&
          (
            isLead() ||
            role() == 'pastor'
          )
        )

        || (
          c == 'preaching' &&
          role() in [
            'pastor',
            'preaching'
          ]
        );

    }


    /* ======================================================
       CONFIG
       ====================================================== */

    match /config/{id} {

      allow read, write: if false;

    }


    /* ======================================================
       SIGNUPS
       ====================================================== */

    match /signups/{uid} {

      allow create:
        if signedIn()
        && request.auth.uid == uid

        && request.resource.data
          .keys()
          .hasOnly([
            'role',
            'code'
          ])

        && request.resource.data.code ==
          get(
            /databases/$(database)/documents/config/roleCodes
          ).data[
            request.resource.data.role
          ];

    }


    /* ======================================================
       USERS
       ====================================================== */

    match /users/{uid} {

      allow read:
        if signedIn();


      /*
        New account.

        The role must match the access code
        already verified in signups/{uid}.
      */

      allow create:
        if signedIn()

        && request.auth.uid == uid

        && request.resource.data
          .keys()
          .hasOnly([
            'role',
            'name',
            'email',
            'createdAt'
          ])

        && exists(
          /databases/$(database)/documents/signups/$(uid)
        )

        && get(
          /databases/$(database)/documents/signups/$(uid)
        ).data.role ==
          request.resource.data.role;


      /*
        ADMIN can update/delete members.

        A normal worker can update ONLY their own name.

        They cannot change:
        - role
        - email
        - createdAt
      */

      allow update:
        if signedIn()

        && (

          role() == 'admin'

          ||

          (
            request.auth.uid == uid

            && request.resource.data
              .diff(resource.data)
              .affectedKeys()
              .hasOnly([
                'name'
              ])

            && request.resource.data.role ==
               resource.data.role

            && request.resource.data.email ==
               resource.data.email

            && request.resource.data.createdAt ==
               resource.data.createdAt
          )

        );


      allow delete:
        if signedIn()
        && role() == 'admin';

    }


    /* ======================================================
       EVENTS / PROJECTS / TASKS / ETC.
       ====================================================== */

    match /{coll}/{id} {

      allow read:
        if signedIn()
        && coll in [
          'events',
          'projects',
          'tasks',
          'inventory',
          'setlists',
          'songs'
        ];


      allow create:
        if signedIn()
        && coll in [
          'events',
          'projects',
          'tasks'
        ]
        && canManage(
          request.resource.data.module
        );


      allow delete:
        if signedIn()
        && coll in [
          'events',
          'projects',
          'tasks'
        ]
        && canManage(
          resource.data.module
        );


      allow update:
        if signedIn()
        && coll in [
          'events',
          'projects',
          'tasks'
        ]
        && canManage(
          resource.data.module
        );

    }


    /* ======================================================
       INVENTORY
       ====================================================== */

    match /inventory/{id} {

      allow create:
        if signedIn()
        && role() in [
          'admin',
          'production',
          'production-lead'
        ];


      allow delete, update:
        if signedIn()
        && role() in [
          'admin',
          'production',
          'production-lead'
        ];

    }


    /* ======================================================
       WORSHIP
       ====================================================== */

    match /setlists/{id} {

      allow create, update, delete:
        if signedIn()
        && worship();

    }


    match /songs/{id} {

      allow create, update, delete:
        if signedIn()
        && worship();

    }


    /* ======================================================
       ANNOUNCEMENTS
       ====================================================== */

    match /announcements/{id} {

      allow read:
        if signedIn()
        && (
          role() in [
            'admin',
            'pastor'
          ]
          || isLead()
        );


      allow create, update, delete:
        if signedIn()
        && role() in [
          'admin',
          'pastor'
        ];

    }


    /* ======================================================
       CHAT
       ====================================================== */

    match /messages/{id} {

      allow read:
        if signedIn()
        && chanOk(
          resource.data.channel
        );


      allow create:
        if signedIn()

        && request.resource.data.uid ==
           request.auth.uid

        && chanOk(
          request.resource.data.channel
        );

    }

  }

}