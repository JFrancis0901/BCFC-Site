// Paste into Firebase Console > Firestore > Rules. This is what REALLY enforces
// permissions; the page code only hides buttons.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role; }
    function isLead() { return role().matches('.*-lead'); }
    // admin, or the lead of that department, or (for preaching modules) the pastor
    function canManage(mod) {
      return role() == 'admin'
        || (role() == 'pastor' && mod in ['sunday','nurture','prayer','other'])
        || (isLead() && role() == mod + '-lead');
    }
    function worship() { return role() in ['admin','pastor','preaching']; }
    function chanOk(c) {
      return role() == 'admin' || c == 'general' || c == role().replace('-lead','')
        || (c == 'leads' && (isLead() || role() == 'pastor'))
        || (c == 'preaching' && role() in ['pastor','preaching']);
    }

    // ---- Sign-up with role codes ----
    // config/roleCodes holds one field per role, e.g. pastor: "BCFC-PST-3107".
    // Nobody can read or write it from the website; only you, in the Firebase Console.
    match /config/{id} { allow read, write: if false; }

    // At sign-up the browser writes {role, code}. It is only accepted if the code matches
    // the one stored for that role. It can't be read back, changed or deleted afterwards.
    match /signups/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['role', 'code'])
        && request.resource.data.code == get(/databases/$(database)/documents/config/roleCodes).data[request.resource.data.role];
    }

    match /users/{uid} {                       // names/roles readable so people can be assigned
      allow read: if signedIn();
      // A new user may create ONLY their own profile, and only with the role whose code they just proved.
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['role', 'name', 'email', 'createdAt'])
        && exists(/databases/$(database)/documents/signups/$(uid))
        && get(/databases/$(database)/documents/signups/$(uid)).data.role == request.resource.data.role;
      allow update, delete: if signedIn() && role() == 'admin';
    }
    match /{coll}/{id} {
      allow read: if signedIn() && coll in ['events','projects','tasks','inventory','setlists','songs'];
      allow create: if signedIn() && coll in ['events','projects','tasks'] && canManage(request.resource.data.module);
      allow delete: if signedIn() && coll in ['events','projects','tasks'] && canManage(resource.data.module);
      allow update: if signedIn() && coll in ['events','projects','tasks'] && canManage(resource.data.module);
    }
    match /inventory/{id} {
      allow create: if signedIn() && (role() in ['admin','production','production-lead']);
      allow delete, update: if signedIn() && (role() in ['admin','production','production-lead']);
    }
    match /setlists/{id} { allow create, update, delete: if signedIn() && worship(); }
    match /songs/{id}    { allow create, update, delete: if signedIn() && worship(); }
    match /announcements/{id} {
      allow read: if signedIn() && (role() in ['admin','pastor'] || isLead());
      allow create, update, delete: if signedIn() && role() in ['admin','pastor'];
    }
    match /messages/{id} {
      allow read: if signedIn() && chanOk(resource.data.channel);
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && chanOk(request.resource.data.channel);
    }
  }
}
